# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
frontend/.next/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep example templates in git
.env*
!.env.example
!.env.production.example
!frontend/.env.development

# vercel
.vercel

# cursor local config (machine-specific MCP settings)
.cursor/mcp.json

# typescript
*.tsbuildinfo
next-env.d.ts
