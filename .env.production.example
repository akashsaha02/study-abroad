# Production dashboard reference — do NOT copy this to .env.local.
# Same variable names as local; different values. Never commit real secrets.

# ---------------------------------------------------------------------------
# Vercel (frontend) → Settings → Environment Variables
# Scope: Production (and Preview only if the API CORS origin matches)
# Redeploy after changing NEXT_PUBLIC_* or BACKEND_URL (build-time).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
BACKEND_URL=https://abroadly-api.onrender.com

# ---------------------------------------------------------------------------
# Render (backend) → Environment
# FRONTEND_URL must match the Vercel origin exactly (no trailing slash).
# ---------------------------------------------------------------------------
FRONTEND_URL=https://your-app.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Abroadly <noreply@yourdomain.com>
ADMIN_EMAIL=admin@yourdomain.com

# Supabase Auth → URL Configuration: also allow
#   https://your-app.vercel.app/auth/callback
