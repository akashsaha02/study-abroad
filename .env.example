# Local development only. Copy to .env.local (gitignored), then run:
#   npm run sync:env
#
# Do not put Vercel or Render URLs here. Production values go in the
# hosting dashboards — see .env.production.example.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URLs (localhost — required for cookies, /api rewrites, and CORS)
NEXT_PUBLIC_APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# Google OAuth (configure in Supabase Dashboard → Authentication → Providers → Google)
# Authorized redirect URI in Google Cloud: https://<project-ref>.supabase.co/auth/v1/callback
# Add http://localhost:3000/auth/callback to Supabase URL Configuration allow list

# Resend
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Abroadly <noreply@yourdomain.com>
ADMIN_EMAIL=admin@yourdomain.com
